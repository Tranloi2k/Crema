# Turso (libSQL) database — required.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-with-a-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_ID=
GITHUB_SECRET=

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Crema <onboarding@resend.dev>

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_PLUS_MONTHLY=
STRIPE_PRICE_PRO_PLUS_ANNUAL=

# NOTE: while GOOGLE_CLIENT_ID and GITHUB_ID are both unset and
# NODE_ENV=development, a temporary "Continue as Dev User" sign-in option
# appears on /login so the builder can be tested before real OAuth keys
# exist. It is automatically disabled once real provider credentials are set,
# and is never active in production. See src/lib/auth.ts.
