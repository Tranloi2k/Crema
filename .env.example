# Turso (libSQL) database — required.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# NextAuth — production: https://your-app.vercel.app (must match deployed domain exactly)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-with-a-random-string
# Vercel: also set AUTH_TRUST_HOST=true if sign-in redirects fail after OAuth/email login
AUTH_TRUST_HOST=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_ID=
GITHUB_SECRET=

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Crema <onboarding@resend.dev>

# Lemon Squeezy (https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=
LEMONSQUEEZY_VARIANT_PRO_PLUS_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_PLUS_ANNUAL=

# UI only — lock Pro/Pro+ upgrade buttons when not "true" (does not block checkout API)
NEXT_PUBLIC_BILLING_UPGRADE_ENABLED=false

# Vercel: add all variables above in Project Settings → Environment Variables.
# Set LEMONSQUEEZY_TEST_MODE=false for production. Webhook URL:
# https://YOUR_DOMAIN/api/billing/webhook

# Dev bypass ("Continue as Dev User") is only available on local npm run dev
# (NODE_ENV=development + NEXTAUTH_URL pointing at localhost). It is never
# enabled on Vercel preview/production. Set ALLOW_DEV_BYPASS=false to force off locally.
# ALLOW_DEV_BYPASS=false
